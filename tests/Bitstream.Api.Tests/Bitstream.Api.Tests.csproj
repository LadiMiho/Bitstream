<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bitstream.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bitstream.Api\Bitstream.Api.csproj" />
    <ProjectReference Include="..\..\src\Bitstream.Web\Bitstream.Web.csproj" />
    <ProjectReference Include="..\..\src\Bitstream.Hosting\Bitstream.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Bitstream.Application\Bitstream.Application.csproj" />
    <ProjectReference Include="..\..\src\Bitstream.Domain\Bitstream.Domain.csproj" />
