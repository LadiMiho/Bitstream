<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bitstream.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitstream.Domain\Bitstream.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DI and options abstractions only, so that each layer can publish its own registration
         extension and bind its own configuration. Neither is infrastructure: no transport,
         no database driver. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- IHostedService/BackgroundService for OutboxDispatcher. Pure hosting abstractions, no
         ASP.NET Core, no transport, no database driver — fits this layer the same way the DI
         and options abstractions above do. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Pure Argon2id computation, no external system, no HTTP, no database driver — fits this
         layer the same way the BCL cryptography types used by TotpService do. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
  </ItemGroup>

  <!--
    TR-ARC-01 / TR-ARC-02: application services may only talk to external systems
    through the ports in Abstractions/Integration. This project must never reference
    Bitstream.Infrastructure.Integration, Bitstream.Infrastructure.Persistence,
    an HTTP client package, or a database driver.
  -->

</Project>
