<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bitstream.Hosting</RootNamespace>
    <!-- Presentation-layer plumbing shared by the two web hosts (Bitstream.Web and
         Bitstream.Api). Framework reference rather than Sdk.Web because this is a library:
         it contributes middleware, options and endpoint mappings, it does not host anything. -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The implicit usings Microsoft.NET.Sdk.Web adds and Microsoft.NET.Sdk does not. The code
      here is presentation-layer plumbing that moved out of a web host, and it is written
      against that set; declaring it explicitly keeps those files identical to how they read
      in a host project rather than sprinkling framework usings through every one of them.
    -->
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-cutting concerns only. This project sits beside the two hosts in the
         presentation layer; it never becomes a back door for Domain or Application to reach
         ASP.NET Core, because nothing below the hosts references it (TR-ARC-01). -->
    <ProjectReference Include="..\Bitstream.Application\Bitstream.Application.csproj" />
  </ItemGroup>

</Project>
