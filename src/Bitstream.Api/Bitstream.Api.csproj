<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Bitstream.Api</RootNamespace>
    <UserSecretsId>bitstream-portal-api</UserSecretsId>
    <!-- Windows Server / IIS hosting. No container targets are imported anywhere. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitstream.Application\Bitstream.Application.csproj" />
    <ProjectReference Include="..\Bitstream.Domain\Bitstream.Domain.csproj" />
    <ProjectReference Include="..\Bitstream.Hosting\Bitstream.Hosting.csproj" />
    <!-- Composition root for the integration host. Persistence is needed because inbound CRM
         events are persisted and applied; Integration provides the CRM gateway the outbox
         dispatcher calls. -->
    <ProjectReference Include="..\Bitstream.Infrastructure.Persistence\Bitstream.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Bitstream.Infrastructure.Integration\Bitstream.Infrastructure.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published OpenAPI contract belongs to this host: it describes the CRM-facing
         interface, which is the only contract another system consumes (TR-INT-01). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

</Project>
