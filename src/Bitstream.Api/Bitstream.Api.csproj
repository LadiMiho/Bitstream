<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Bitstream.Api</RootNamespace>
    <UserSecretsId>bitstream-portal-api</UserSecretsId>
    <!-- Windows Server / IIS hosting. No container targets are imported anywhere. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitstream.Application\Bitstream.Application.csproj" />
    <ProjectReference Include="..\Bitstream.Domain\Bitstream.Domain.csproj" />
    <!-- Composition root only: the two Infrastructure projects are referenced here
         so their DI registration extensions can be called from Program.cs. No
         endpoint or service in this project may use their types directly. -->
    <ProjectReference Include="..\Bitstream.Infrastructure.Persistence\Bitstream.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Bitstream.Infrastructure.Integration\Bitstream.Infrastructure.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!--
    Frontend: Razor Pages under /Pages, styled with Tailwind CSS.

    The stylesheet source is ClientAssets/app.css; the compiled, minified output is
    wwwroot/css/app.css, referenced by Pages/Shared/_Layout.cshtml. There is no Node.js, npm
    or package.json anywhere in this project — Tailwind is compiled by its standalone CLI, a
    single self-contained native executable with no runtime dependency, downloaded on demand
    into tools/tailwindcss/ (outside source control) and invoked as a plain MSBuild Exec step.

    Set BuildFrontend=true to (re)build the stylesheet — this is the only step that needs
    network access, to fetch the CLI binary the first time:
        dotnet build src/Bitstream.Api -p:BuildFrontend=true
        dotnet publish src/Bitstream.Api -c Release -p:BuildFrontend=true
    Left false by default so an ordinary backend build never touches the network. Without it,
    publish uses whatever wwwroot/css/app.css is already on disk and warns if there is none.
  -->
  <PropertyGroup>
    <TailwindCliVersion>4.3.3</TailwindCliVersion>
    <TailwindToolsDir>$(MSBuildThisFileDirectory)..\..\tools\tailwindcss\</TailwindToolsDir>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">false</BuildFrontend>
  </PropertyGroup>

  <!--
    Official release asset names from https://github.com/tailwindlabs/tailwindcss/releases.
    windows-x64 is the only one that matters for CI and for the IIS deployment target
    (TR-ARC-07); linux-x64 and macos-arm64 are included only so the stylesheet can also be
    built on a Linux or Apple Silicon development machine. An architecture outside these three
    is not supported by this target — build the CSS on a supported machine and commit nothing,
    since wwwroot/css/app.css is generated and gitignored either way.
  -->
  <PropertyGroup Condition="'$(BuildFrontend)' == 'true'">
    <TailwindCliAsset Condition="'$(OS)' == 'Windows_NT'">tailwindcss-windows-x64.exe</TailwindCliAsset>
    <TailwindCliAsset Condition="'$(OS)' != 'Windows_NT' AND $([MSBuild]::IsOSPlatform('OSX'))">tailwindcss-macos-arm64</TailwindCliAsset>
    <TailwindCliAsset Condition="'$(OS)' != 'Windows_NT' AND $([MSBuild]::IsOSPlatform('Linux'))">tailwindcss-linux-x64</TailwindCliAsset>
    <TailwindCliPath>$(TailwindToolsDir)$(TailwindCliAsset)</TailwindCliPath>
  </PropertyGroup>

  <Target Name="EnsureTailwindCli" Condition="'$(BuildFrontend)' == 'true' AND !Exists('$(TailwindCliPath)')">
    <Error Condition="'$(TailwindCliAsset)' == ''" Text="No standalone Tailwind CLI release is mapped for this OS. Supported: Windows, Linux, macOS (x64/Exec on all three, arm64 on macOS)." />
    <MakeDir Directories="$(TailwindToolsDir)" />
    <DownloadFile
      SourceUrl="https://github.com/tailwindlabs/tailwindcss/releases/download/v$(TailwindCliVersion)/$(TailwindCliAsset)"
      DestinationFolder="$(TailwindToolsDir)" />
    <!-- GitHub release assets ship without the executable bit; Windows ignores file-mode bits,
         so this only matters when building on Linux or macOS. -->
    <Exec Command="chmod +x &quot;$(TailwindCliPath)&quot;" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <Target Name="BuildFrontendAssets"
          DependsOnTargets="EnsureTailwindCli"
          BeforeTargets="Build;ComputeFilesToPublish"
          Condition="'$(BuildFrontend)' == 'true'">
    <Exec Command="&quot;$(TailwindCliPath)&quot; -i ClientAssets/app.css -o wwwroot/css/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="WarnIfStylesheetMissing" BeforeTargets="ComputeFilesToPublish">
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\app.css')"
             Text="wwwroot/css/app.css not found. Build or publish with -p:BuildFrontend=true to compile it." />
  </Target>

</Project>
