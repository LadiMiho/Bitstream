<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the Bitstream Portal API on Windows Server.
  The ASP.NET Core Module v2 hosts the application in process (see AspNetCoreHostingModel
  in the project file). Publishing overwrites the processPath and arguments attributes.

  This file is the deployment contract for the web tier: there is no container image, no
  compose file and no orchestrator anywhere in this solution.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Bitstream.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Set per environment by the deployment script; never checked in (TR-ARC-07). -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!-- Attachment size is configurable; whether attachments are in Release 1 at all
               is TRD 11.4 open item 12. 30 MB placeholder. -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- TR-SEC-27: OWASP Top 10 hardening at the edge. -->
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="no-referrer" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
