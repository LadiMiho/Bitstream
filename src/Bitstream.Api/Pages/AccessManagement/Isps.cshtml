@page
@model Bitstream.Api.Pages.AccessManagement.IspsModel
@{
    ViewData["Title"] = "ISP Administration";
}

<div class="grid gap-6" data-role="isp-admin-page" data-can-lock="@Model.CanLock.ToString().ToLowerInvariant()">
    <div>
        <a href="/AccessManagement" class="text-sm text-brand-600 underline">&larr; Access Management</a>
        <h1 class="mt-2 text-xl font-semibold">ISP Administration</h1>
    </div>

    <section class="card border-l-4 border-state-pending" aria-labelledby="isp-gap-heading">
        <h2 id="isp-gap-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">No list endpoint yet</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-muted">
            The backend does not currently expose a way to browse or search ISPs — only
            <code class="rounded bg-surface-muted px-1">GET /api/v1/isps/{ispId}</code> by a
            known ID. Look up an ISP by its ID below, or use the ID an ISP was created with.
        </p>
    </section>

    @if (Model.CanCreate)
    {
        <section class="card" aria-labelledby="isp-create-heading">
            <h2 id="isp-create-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Create ISP</h2>
            <form id="isp-create-form" class="mt-4 grid max-w-xl gap-4" novalidate>
                <p id="isp-create-error" class="field-error" role="alert" hidden></p>
                <div>
                    <label class="field-label" for="isp-create-name">Name</label>
                    <input class="field-input" id="isp-create-name" name="name" type="text" required />
                </div>
                <div>
                    <label class="field-label" for="isp-create-nipt">NIPT</label>
                    <input class="field-input" id="isp-create-nipt" name="nipt" type="text" required />
                </div>
                <div>
                    <label class="field-label" for="isp-create-contact-person">Contact person</label>
                    <input class="field-input" id="isp-create-contact-person" name="contactPerson" type="text" required />
                </div>
                <div>
                    <label class="field-label" for="isp-create-contact-email">Contact email</label>
                    <input class="field-input" id="isp-create-contact-email" name="contactEmail" type="email" required />
                </div>
                <div>
                    <label class="field-label" for="isp-create-contact-mobile">Contact mobile</label>
                    <input class="field-input" id="isp-create-contact-mobile" name="contactMobile" type="tel" placeholder="+355..." required />
                </div>
                <div>
                    <label class="field-label" for="isp-create-crm-bp">CRM Business Partner reference</label>
                    <input class="field-input" id="isp-create-crm-bp" name="crmBpReference" type="text" required />
                </div>
                <div>
                    <button type="submit" class="btn-primary">Create ISP</button>
                </div>
            </form>
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="isp-create-denied-heading">
            <h2 id="isp-create-denied-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Create ISP</h2>
            <p class="mt-2 text-sm text-ink-muted">Your role does not hold <code class="rounded bg-surface-muted px-1">isp.create</code>.</p>
        </section>
    }

    <section class="card" aria-labelledby="isp-lookup-heading">
        <h2 id="isp-lookup-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Look up an ISP</h2>
        <form id="isp-lookup-form" class="mt-4 flex max-w-md items-end gap-3" novalidate>
            <div class="flex-1">
                <label class="field-label" for="isp-lookup-id">ISP ID</label>
                <input class="field-input" id="isp-lookup-id" name="ispId" type="number" min="1" required />
            </div>
            <button type="submit" class="btn-secondary">Look up</button>
        </form>
        <p id="isp-lookup-error" class="field-error mt-2" role="alert" hidden></p>

        <div id="isp-detail" class="mt-6" hidden>
            <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">ISP ID</dt><dd id="isp-detail-id" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Status</dt><dd id="isp-detail-status" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Name</dt><dd id="isp-detail-name" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">NIPT</dt><dd id="isp-detail-nipt" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Contact person</dt><dd id="isp-detail-contact-person" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Contact email</dt><dd id="isp-detail-contact-email" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Contact mobile</dt><dd id="isp-detail-contact-mobile" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">CRM BP reference</dt><dd id="isp-detail-crm-bp" class="mt-1 text-sm"></dd></div>
            </dl>

            @if (Model.CanLock)
            {
                <div class="mt-4 flex gap-2">
                    <button type="button" id="isp-lock-button" class="btn-secondary">Lock</button>
                    <button type="button" id="isp-unlock-button" class="btn-secondary">Unlock</button>
                </div>
                <p id="isp-status-error" class="field-error mt-2" role="alert" hidden></p>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/isp-admin.js"></script>
}
