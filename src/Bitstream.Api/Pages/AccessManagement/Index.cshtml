@page
@model Bitstream.Api.Pages.AccessManagement.IndexModel
@{
    ViewData["Title"] = "Access Management";
}

<section class="card" aria-labelledby="page-heading">
    <h1 id="page-heading" class="text-xl font-semibold">Access Management</h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">
        User, ISP and role administration (TRD §4).
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <a href="/AccessManagement/Isps" class="rounded-md border border-line p-4 hover:bg-surface-muted">
            <div class="text-sm font-semibold">ISP administration</div>
            <div class="mt-1 text-sm text-ink-muted">Create ISPs, look one up, lock or unlock it.</div>
        </a>
        <a href="/AccessManagement/Users" class="rounded-md border border-line p-4 hover:bg-surface-muted">
            <div class="text-sm font-semibold">User administration</div>
            <div class="mt-1 text-sm text-ink-muted">Create users, look one up, lock or unlock it.</div>
        </a>
        <a href="/AccessManagement/AuditLog" class="rounded-md border border-line p-4 hover:bg-surface-muted">
            <div class="text-sm font-semibold">Audit log</div>
            <div class="mt-1 text-sm text-ink-muted">Search and export — not available yet, see the page for why.</div>
        </a>
    </div>
</section>
