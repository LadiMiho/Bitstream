@page
@model Bitstream.Api.Pages.ActivationRequests.DetailModel
@{
    ViewData["Title"] = "Activation Request";
}

<div class="grid gap-6" data-role="activation-detail-page" data-public-id="@Model.PublicId">
    <div>
        <a href="/ActivationRequests" class="text-sm text-brand-600 underline">&larr; Activation Requests</a>
        <h1 class="mt-2 text-xl font-semibold">Look up a request</h1>
    </div>

    <section class="card border-l-4 border-state-pending" aria-labelledby="detail-gap-heading">
        <h2 id="detail-gap-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">No list endpoint yet</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-muted">
            The backend does not currently expose a way to browse or search activation requests —
            only <code class="rounded bg-surface-muted px-1">GET /api/v1/activation-requests/{publicId}</code>
            by a known public ID. Look up a request by the ID it was given on submission.
        </p>
    </section>

    <section class="card">
        <form id="activation-lookup-form" class="flex max-w-md items-end gap-3" novalidate>
            <div class="flex-1">
                <label class="field-label" for="activation-lookup-id">Public ID</label>
                <input class="field-input" id="activation-lookup-id" name="publicId" type="text" placeholder="e.g. ACT_1001" required />
            </div>
            <button type="submit" class="btn-secondary">Look up</button>
        </form>
        <p id="activation-lookup-error" class="field-error mt-2" role="alert" hidden></p>

        <div id="activation-detail" class="mt-6" hidden>
            <div class="flex items-center gap-3">
                <h2 id="activation-detail-public-id" class="text-lg font-semibold"></h2>
                <span id="activation-detail-status"></span>
            </div>
            <p id="activation-detail-status-reason" class="mt-1 text-sm text-state-blocked"></p>

            <dl class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">ISP ID</dt><dd id="activation-detail-isp-id" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Package</dt><dd id="activation-detail-package" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Location</dt><dd id="activation-detail-location" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Coordinates</dt><dd id="activation-detail-coordinates" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Classification</dt><dd id="activation-detail-classification" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Contract duration</dt><dd id="activation-detail-duration" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Sales order</dt><dd id="activation-detail-sales-order" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Submitted</dt><dd id="activation-detail-created" class="mt-1 text-sm"></dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Last updated</dt><dd id="activation-detail-updated" class="mt-1 text-sm"></dd></div>
                <div class="sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Comments</dt><dd id="activation-detail-comments" class="mt-1 text-sm whitespace-pre-wrap"></dd></div>
            </dl>
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/activation-detail.js"></script>
}
