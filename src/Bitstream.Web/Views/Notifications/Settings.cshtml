@model IReadOnlyList<Bitstream.Application.Services.Notifications.NotificationSetting>
@using Bitstream.Domain.Entities
@{
    ViewData["Title"] = "Notification settings";

    var groups = new[]
    {
        (EntityType: NotificationEntityTypes.ActivationRequest, Title: "Activation requests", Description: "When an activation request reaches the status"),
        (EntityType: NotificationEntityTypes.PostActivationRequest, Title: "Post-activation requests", Description: "When a post-activation request reaches the status")
    };
}

<div class="grid gap-6" data-role="notification-settings-page">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold">Notification settings</h1>
            <p class="mt-1 text-sm text-ink-muted">Choose which status changes notify whom, in the portal (the bell in the header and the Notifications page) and by email.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <span id="notification-settings-saved" class="status-pill bg-state-done/15 text-state-done" role="status" hidden>Saved</span>
            <button type="button" id="notification-settings-save" class="btn-primary">Save changes</button>
        </div>
    </div>

    <section class="card min-w-0 px-5 py-4 text-sm text-ink-muted" aria-label="Who is notified">
        <dl class="grid gap-3 sm:grid-cols-2">
            <div>
                <dt class="font-semibold text-ink">ISP users</dt>
                <dd class="mt-0.5">Every active user of the ISP the request belongs to.</dd>
            </div>
            <div>
                <dt class="font-semibold text-ink">Service desk</dt>
                <dd class="mt-0.5">Every active user with the ServiceDesk role.</dd>
            </div>
        </dl>
        <p class="mt-3">The person who made a change is never notified of their own change. Emails go to the address of each user's account; their wording is set in the configuration (<code class="text-xs">Notifications:Email</code>).</p>
        <p id="notification-settings-error" class="field-error mt-2" role="alert" hidden></p>
    </section>

    @foreach (var group in groups)
    {
        var headingId = $"notification-settings-{group.EntityType}";
        <section class="card min-w-0 p-0" aria-labelledby="@headingId">
            <div class="border-b border-line px-6 py-4">
                <h2 id="@headingId" class="text-base font-semibold text-ink">@group.Title</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr>
                            <th class="table-head align-bottom" rowspan="2">@group.Description</th>
                            <th class="table-head border-l border-line text-center" colspan="2">ISP users</th>
                            <th class="table-head border-l border-line text-center" colspan="2">Service desk</th>
                        </tr>
                        <tr>
                            <th class="table-head w-24 border-l border-line text-center font-normal normal-case">In app</th>
                            <th class="table-head w-24 text-center font-normal normal-case">Email</th>
                            <th class="table-head w-24 border-l border-line text-center font-normal normal-case">In app</th>
                            <th class="table-head w-24 text-center font-normal normal-case">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var setting in Model.Where(s => s.EntityType == group.EntityType))
                        {
                            var code = NotificationAudiences.EventCode(setting.EntityType, setting.Status);
                            var label = NotificationPresenter.StatusLabel(setting.EntityType, setting.Status);
                            <tr class="border-t border-line">
                                <td class="table-cell"><span class="@NotificationPresenter.StatusPillClass(setting.EntityType, setting.Status)">@label</span></td>
                                @foreach (var (audience, audienceName, inApp, email) in new[]
                                {
                                    (NotificationAudiences.IspUsers, "ISP users", setting.IspUsers, setting.IspUsersEmail),
                                    (NotificationAudiences.ServiceDesk, "the service desk", setting.ServiceDesk, setting.ServiceDeskEmail)
                                })
                                {
                                    <td class="table-cell border-l border-line text-center">
                                        <input type="checkbox" class="h-4 w-4 cursor-pointer rounded border-line accent-brand-600" aria-label="Notify @audienceName in the portal when an item reaches @label"
                                               data-event-code="@code" data-audience="@audience" data-channel="@NotificationChannels.InApp" checked="@inApp" />
                                    </td>
                                    <td class="table-cell text-center">
                                        <input type="checkbox" class="h-4 w-4 cursor-pointer rounded border-line accent-brand-600" aria-label="Email @audienceName when an item reaches @label"
                                               data-event-code="@code" data-audience="@audience" data-channel="@NotificationChannels.Email" checked="@email" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/pages/notification-settings.js"></script>
}
