@model Bitstream.Application.Identity.Entities.User
<form id="user-password-form" class="grid gap-4" novalidate data-action="change-password" data-user-id="@Model.Id">
    <p class="text-sm text-ink-muted">Setting a new password for <strong>@Model.FullName</strong> (@Model.Email).</p>
    <p class="field-error" role="alert" hidden></p>
    <div>
        <label class="field-label" for="user-password-new">New password</label>
        <input class="field-input" id="user-password-new" name="newPassword" type="password" required />
        <span class="mt-1 block text-xs text-ink-muted">Must satisfy the configured password policy — the API reports specifics if it does not.</span>
    </div>
    <div class="flex justify-end gap-2">
        <button type="button" class="btn-secondary" data-drawer-cancel>Cancel</button>
        <button type="submit" class="btn-primary">Set password</button>
    </div>
</form>
