@{
    ViewData["Title"] = "User Administration";
    var canCreate = (bool)(ViewBag.CanCreate ?? false);
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var canLock = (bool)(ViewBag.CanLock ?? false);
    var roles = (IReadOnlyList<string>)(ViewBag.Roles ?? Array.Empty<string>());
}

<div class="grid gap-6"
     data-role="user-admin-page"
     data-can-create="@canCreate.ToString().ToLowerInvariant()"
     data-can-edit="@canEdit.ToString().ToLowerInvariant()"
     data-can-lock="@canLock.ToString().ToLowerInvariant()">
    <div class="flex items-center justify-between">
        <div>
            <a href="/AccessManagement" class="text-sm text-brand-600 underline">&larr; Access Management</a>
            <h1 class="mt-2 text-xl font-semibold">User Administration</h1>
        </div>

        @if (canCreate)
        {
            <button type="button" id="user-add-button" class="btn-primary">Add user</button>
        }
    </div>

    <section class="card" aria-labelledby="user-search-heading">
        <h2 id="user-search-heading" class="sr-only">Users</h2>

        <div class="flex flex-wrap items-center gap-3">
            <form id="user-search-form" class="search-input-group flex-1 min-w-[16rem] max-w-sm" novalidate>
                <label class="sr-only" for="user-search-query">Search by name or email</label>
                <span class="search-input-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><circle cx="9" cy="9" r="6" /><path d="m17 17-3.5-3.5" stroke-linecap="round" /></svg>
                </span>
                <input class="field-input mt-0" id="user-search-query" name="search" type="search" placeholder="Search by name or email" />
            </form>

            <div class="relative">
                <button type="button" id="user-filters-button" class="btn-secondary" aria-expanded="false" aria-controls="user-filters-panel">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="M3 4h14M6 10h8M9 16h2" stroke-linecap="round" /></svg>
                    Filters
                    <span id="user-filters-count" class="badge bg-brand-50 text-brand-700" hidden>0</span>
                </button>

                <div id="user-filters-panel" class="popover-panel" hidden>
                    <form id="user-filters-form" novalidate>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="field-label" for="user-filter-role">Role</label>
                                <select class="field-input" id="user-filter-role" name="role">
                                    <option value="">All</option>
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label" for="user-filter-status">Status</label>
                                <select class="field-input" id="user-filter-status" name="status">
                                    <option value="">All</option>
                                    <option value="Active">Active</option>
                                    <option value="Locked">Locked</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" id="user-filters-reset" class="btn-secondary">Reset</button>
                            <button type="submit" class="btn-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="user-filter-chips" class="flex flex-wrap items-center gap-2"></div>
        </div>

        <p id="user-search-error" class="field-error mt-2" role="alert" hidden></p>

        <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr>
                        <th class="table-head">Name</th>
                        <th class="table-head">Role</th>
                        <th class="table-head">Status</th>
                        <th class="table-head">Last login</th>
                        <th class="table-head"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="user-search-results"></tbody>
            </table>
            <p id="user-search-empty" class="mt-3 text-sm text-ink-muted" hidden>No users match.</p>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-ink-muted">
            <span id="user-search-summary"></span>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2">
                    <span>Per page</span>
                    <select id="user-page-size" class="field-input mt-0 w-auto py-1.5">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <div class="flex items-center gap-1">
                    <button type="button" id="user-search-prev" class="icon-button" disabled aria-label="Previous page">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="m12 4-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                    <span id="user-page-number" class="min-w-[2rem] rounded-md bg-ink px-2.5 py-1 text-center text-xs font-semibold text-white">1</span>
                    <button type="button" id="user-search-next" class="icon-button" disabled aria-label="Next page">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="m8 4 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/user-admin.js"></script>
}
