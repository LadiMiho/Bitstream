@model Bitstream.Domain.Entities.User
@{
    var roles = (IReadOnlyList<string>)(ViewBag.Roles ?? Array.Empty<string>());
}
<form id="user-edit-form" class="grid gap-4" novalidate data-action="update" data-user-id="@Model.UserId">
    <p class="field-error" role="alert" hidden></p>
    <div>
        <label class="field-label" for="user-edit-full-name">Full name</label>
        <input class="field-input" id="user-edit-full-name" name="fullName" type="text" value="@Model.FullName" required />
    </div>
    <div>
        <label class="field-label" for="user-edit-email">Email</label>
        <input class="field-input" id="user-edit-email" name="email" type="email" value="@Model.Email" required />
    </div>
    <div>
        <label class="field-label" for="user-edit-mobile">Mobile</label>
        <input class="field-input" id="user-edit-mobile" name="mobile" type="tel" value="@Model.Mobile" required />
    </div>
    <div>
        <label class="field-label" for="user-edit-role">Role</label>
        <select class="field-input" id="user-edit-role" name="roleName" required>
            @foreach (var role in roles)
            {
                <option value="@role" selected="@(role == Model.Role.Name)">@role</option>
            }
        </select>
    </div>
    <div>
        <label class="field-label" for="user-edit-isp-id">ISP ID</label>
        <input class="field-input" id="user-edit-isp-id" name="ispId" type="number" min="1" value="@Model.IspId" />
        <span class="mt-1 block text-xs text-ink-muted">Leave blank for an internal user (Administrator, Service Desk, Auditor).</span>
    </div>
    <div class="flex justify-end gap-2">
        <button type="button" class="btn-secondary" data-drawer-cancel>Cancel</button>
        <button type="submit" class="btn-primary">Save changes</button>
    </div>
</form>
