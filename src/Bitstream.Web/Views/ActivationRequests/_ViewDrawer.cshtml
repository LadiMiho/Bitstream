@model Bitstream.Web.Presentation.ActivationRequestDetailsViewModel
@using Bitstream.Application.Services.Activation
@{
    var request = Model.Request;

    string DotClass(ActivationTimelineOutcome outcome) => outcome switch
    {
        ActivationTimelineOutcome.Succeeded => "bg-state-done",
        ActivationTimelineOutcome.Pending or ActivationTimelineOutcome.Retrying => "bg-state-pending",
        ActivationTimelineOutcome.Discarded => "bg-ink-muted",
        _ => "bg-state-blocked"
    };

    string OutcomeLabel(ActivationTimelineEntry entry) => entry.Outcome switch
    {
        ActivationTimelineOutcome.Succeeded => entry.Kind == ActivationTimelineKind.Inbound ? "Applied" : "Done",
        ActivationTimelineOutcome.Pending => entry.Kind == ActivationTimelineKind.Outbound ? "Waiting to be sent" : "Waiting",
        ActivationTimelineOutcome.Retrying => $"Failed, retrying (attempt {entry.Attempts})",
        ActivationTimelineOutcome.Failed => "Failed",
        ActivationTimelineOutcome.Rejected => "Rejected",
        ActivationTimelineOutcome.Discarded => "Ignored",
        _ => entry.Outcome.ToString()
    };

    string OutcomeClass(ActivationTimelineOutcome outcome) => outcome switch
    {
        ActivationTimelineOutcome.Succeeded => "text-state-done",
        ActivationTimelineOutcome.Pending or ActivationTimelineOutcome.Retrying => "text-state-pending",
        ActivationTimelineOutcome.Discarded => "text-ink-muted",
        _ => "text-state-blocked"
    };

    (string Label, string Class) Direction(ActivationTimelineKind kind) => kind switch
    {
        ActivationTimelineKind.Outbound => ("Portal → CRM", "bg-state-progress/15 text-state-progress"),
        ActivationTimelineKind.Inbound => ("CRM → Portal", "bg-brand-600/10 text-brand-600"),
        _ => ("Portal", "bg-surface-muted text-ink-muted")
    };
}

@* --- Main information ------------------------------------------------------------------ *@
<section aria-labelledby="activation-view-main" class="grid gap-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 id="activation-view-main" class="text-lg font-semibold text-ink">@request.PublicId</h3>
        <span class="@ActivationStatusLabels.PillClass(request.Status)">@ActivationStatusLabels.For(request.Status)</span>
    </div>

    @if (request.StatusReason is not null)
    {
        <p class="rounded-md border border-state-blocked/30 bg-state-blocked/10 px-3 py-2 text-sm text-state-blocked">@request.StatusReason</p>
    }

    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">ISP</dt><dd class="mt-1 text-sm">@request.Isp.Name (#@request.IspId)</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Package</dt><dd class="mt-1 text-sm">@request.PackageCode · @request.ContractDurationMonths months@(request.OfferCode is null ? "" : $" · code {request.OfferCode}")</dd></div>
        <div class="sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Location</dt><dd class="mt-1 break-all text-sm">@request.LocationRaw</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Coordinates</dt><dd class="mt-1 text-sm">@request.LocationLat, @request.LocationLng</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Classification</dt><dd class="mt-1 text-sm">@request.Classification</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Business Partner</dt><dd class="mt-1 text-sm">@(request.Bp ?? "—")</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">CRM ticket</dt><dd class="mt-1 text-sm">@(request.CrmTicketId ?? "—")</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Sales order</dt><dd class="mt-1 text-sm">@(request.SalesOrderId ?? "Not yet raised")</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Submitted</dt><dd class="mt-1 text-sm">@request.CreatedAt.ToString("g")</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Last updated</dt><dd class="mt-1 text-sm">@(request.LastUpdatedAt?.ToString("g") ?? "—")</dd></div>
        <div class="sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Comments</dt><dd class="mt-1 whitespace-pre-wrap text-sm">@(request.Comments ?? "(none)")</dd></div>
    </dl>
</section>

@* --- Timeline: everything exchanged with CRM, plus portal users' actions, oldest first ---- *@
<section aria-labelledby="activation-view-timeline" class="mt-8" data-role="activation-timeline">
    <h3 id="activation-view-timeline" class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Communication with CRM</h3>

    @if (Model.Timeline.Count == 0)
    {
        <p class="mt-3 text-sm text-ink-muted">No communication with CRM yet.</p>
    }
    else
    {
        <ol class="relative mt-4 border-l border-line pl-6">
            @foreach (var entry in Model.Timeline)
            {
                var direction = Direction(entry.Kind);
                <li class="relative mb-6 last:mb-0" data-kind="@entry.Kind" data-outcome="@entry.Outcome">
                    <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full ring-4 ring-surface @DotClass(entry.Outcome)" aria-hidden="true"></span>

                    <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded px-1.5 py-0.5 text-xs font-medium @direction.Class">@direction.Label</span>
                        <span class="text-sm font-medium text-ink">@entry.Title</span>
                    </div>

                    <div class="mt-1 text-xs text-ink-muted">
                        <time datetime="@entry.At.ToString("O")">@entry.At.ToString("g")</time>
                        · @entry.Actor
                        · <span class="@OutcomeClass(entry.Outcome)">@OutcomeLabel(entry)</span>
                        @if (entry.CompletedAt is { } completedAt && entry.Kind == ActivationTimelineKind.Outbound && entry.Outcome == ActivationTimelineOutcome.Succeeded)
                        {
                            <span>· answered @completedAt.ToString("g")</span>
                        }
                    </div>

                    @if (entry.Summary is not null)
                    {
                        <p class="mt-1 whitespace-pre-wrap text-sm text-ink">@entry.Summary</p>
                    }

                    @if (entry.Error is not null)
                    {
                        <p class="mt-1 text-sm @(entry.Outcome == ActivationTimelineOutcome.Discarded ? "text-ink-muted" : "text-state-blocked")">@entry.Error</p>
                    }

                    @if (Model.ShowRawData && (entry.RawRequest is not null || entry.RawResponse is not null))
                    {
                        <details class="mt-2" data-role="timeline-raw">
                            <summary class="cursor-pointer text-xs text-brand-600">Show data</summary>
                            @if (entry.RawRequest is not null)
                            {
                                <p class="mt-2 text-xs font-semibold text-ink-muted">@(entry.Kind == ActivationTimelineKind.Inbound ? "Received" : "Sent")</p>
                                <pre class="mt-1 max-h-64 overflow-auto rounded bg-surface-muted p-2 text-xs">@entry.RawRequest</pre>
                            }
                            @if (entry.RawResponse is not null)
                            {
                                <p class="mt-2 text-xs font-semibold text-ink-muted">@(entry.Kind == ActivationTimelineKind.Inbound ? "Result" : "CRM response")</p>
                                <pre class="mt-1 max-h-64 overflow-auto rounded bg-surface-muted p-2 text-xs">@entry.RawResponse</pre>
                            }
                        </details>
                    }
                </li>
            }
        </ol>
    }
</section>

<template data-drawer-footer>
    <button type="button" class="btn-secondary" data-drawer-cancel>Close</button>
</template>
