@using Bitstream.Application.Services
@using Bitstream.Domain.Entities
@{
    var callerIspId = (string?)ViewBag.CallerIspId;
    var isps = (IReadOnlyList<Isp>)(ViewBag.Isps ?? Array.Empty<Isp>());
    var catalogue = (ActivationCatalogue)ViewBag.Catalogue;
}
<form id="activation-add-form" class="grid gap-4" novalidate data-action="create">
    <p class="field-error" role="alert" data-field-error="request" hidden></p>

    <div>
        <label class="field-label" for="activation-add-isp-id">ISP</label>
        <select class="field-input" id="activation-add-isp-id" name="ispId" required disabled="@(!string.IsNullOrEmpty(callerIspId))">
            <option value="">— Select an ISP —</option>
            @foreach (var isp in isps)
            {
                <option value="@isp.IspId" selected="@(string.Equals(isp.IspId.ToString(), callerIspId, StringComparison.Ordinal))">@isp.Name — @isp.Nipt</option>
            }
        </select>
        <p class="field-error" role="alert" data-field-error="ispId" hidden></p>
    </div>

    <div>
        <label class="field-label" for="activation-add-package">Package</label>
        <select class="field-input" id="activation-add-package" name="packageCode" required>
            <option value="">— Select a package —</option>
            @foreach (var package in catalogue.Packages)
            {
                <option value="@package.Code">@package.Name</option>
            }
        </select>
        <p class="field-error" role="alert" data-field-error="packageCode" hidden></p>
    </div>

    <div>
        <label class="field-label" for="activation-add-location">Location</label>
        <input class="field-input" id="activation-add-location" name="locationRaw" type="text" placeholder="Map link, or 'latitude,longitude'" required />
        <p class="field-error" role="alert" data-field-error="locationRaw" hidden></p>
    </div>

    <div>
        <label class="field-label" for="activation-add-classification">Ticket classification</label>
        <select class="field-input" id="activation-add-classification" name="classification">
            @foreach (var classification in catalogue.Classifications)
            {
                <option value="@classification.Code" selected="@classification.IsDefault">@classification.Name</option>
            }
        </select>
        <p class="field-error" role="alert" data-field-error="classification" hidden></p>
    </div>

    <div>
        <label class="field-label" for="activation-add-duration">Contract duration</label>
        <select class="field-input" id="activation-add-duration" name="contractDurationMonths" required>
            <option value="">— Select a duration —</option>
            @foreach (var duration in catalogue.ContractDurations)
            {
                <option value="@duration.Months">@duration.Label</option>
            }
        </select>
        <p class="field-error" role="alert" data-field-error="contractDurationMonths" hidden></p>
    </div>

    <div>
        <label class="field-label" for="activation-add-comments">Comments</label>
        <textarea class="field-input" id="activation-add-comments" name="comments" rows="4" maxlength="2000"></textarea>
        <p class="field-error" role="alert" data-field-error="comments" hidden></p>
    </div>
</form>
<template data-drawer-footer>
    <button type="button" class="btn-secondary" data-drawer-cancel>Cancel</button>
    <button type="submit" form="activation-add-form" class="btn-primary">Submit request</button>
</template>
