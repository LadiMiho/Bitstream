@{
    ViewData["Title"] = "Activation Requests";
    var canCreate = (bool)(ViewBag.CanCreate ?? false);
    var canManageCatalogue = (bool)(ViewBag.CanManageCatalogue ?? false);
    var canConfirm = (bool)(ViewBag.CanConfirm ?? false);
    var canServiceDeskDecide = (bool)(ViewBag.CanServiceDeskDecide ?? false);
    var filterIsps = ViewBag.FilterIsps as IReadOnlyList<Bitstream.Domain.Entities.Isp>;
    var filterPackages = (ViewBag.FilterPackages as IReadOnlyList<Bitstream.Domain.Entities.Package>) ?? [];
    var filterDurations = (ViewBag.FilterDurations as IReadOnlyList<Bitstream.Domain.Entities.ContractDuration>) ?? [];
    var showIsp = filterIsps is not null;
}

<div class="grid gap-6"
     data-role="activation-admin-page"
     data-show-isp="@showIsp.ToString().ToLowerInvariant()"
     data-can-confirm="@canConfirm.ToString().ToLowerInvariant()"
     data-can-service-desk-decide="@canServiceDeskDecide.ToString().ToLowerInvariant()">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold">Activation Requests</h1>
            <p class="mt-1 text-sm text-ink-muted">Requests for a new line, from submission to activation.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @if (canManageCatalogue)
            {
                <a href="/ActivationRequests/Catalogue" class="btn-secondary">Packages &amp; durations</a>
                <a href="/ActivationRequests/PackageOffers" class="btn-secondary">Package offers</a>
            }
            <button type="button" id="activation-export-button" class="btn-secondary" title="Download every request matching the search and filters, all pages">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14v2h12v-2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Export to Excel
            </button>
            @if (canCreate)
            {
                <button type="button" id="activation-add-button" class="btn-primary">New request</button>
            }
        </div>
    </div>

    @* Search, the Filters popup and the applied-filter pills, in their own card above the grid. *@
    <section class="card min-w-0 px-5 py-4" aria-labelledby="activation-filters-heading">
        <h2 id="activation-filters-heading" class="sr-only">Search and filters</h2>

        <div class="flex flex-wrap items-center gap-3">
            <form id="activation-search-form" class="search-input-group flex-1 min-w-[16rem] max-w-sm" novalidate>
                <label class="sr-only" for="activation-search-query">Search by public ID or package</label>
                <span class="search-input-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><circle cx="9" cy="9" r="6" /><path d="m17 17-3.5-3.5" stroke-linecap="round" /></svg>
                </span>
                <input class="field-input mt-0" id="activation-search-query" name="search" type="search" placeholder="Search by public ID or package" />
            </form>

            <div class="relative">
                <button type="button" id="activation-filters-button" class="btn-secondary" aria-expanded="false" aria-controls="activation-filters-panel">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="M3 4h14M6 10h8M9 16h2" stroke-linecap="round" /></svg>
                    Filters
                    <span id="activation-filters-count" class="badge bg-brand-50 text-brand-700" hidden>0</span>
                </button>

                <div id="activation-filters-panel" class="popover-panel" hidden>
                    <form id="activation-filters-form" novalidate>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div class="sm:col-span-2">
                                <label class="field-label" for="activation-filter-status">Status</label>
                                <select class="field-input" id="activation-filter-status" name="status">
                                    <option value="">All</option>
                                    <option value="Submitted">Submitted</option>
                                    <option value="PendingCrmSync">Pending CRM Sync</option>
                                    <option value="AwaitingGisVerification">Awaiting GIS Verification</option>
                                    <option value="RejectedNoLine">Rejected — No Line</option>
                                    <option value="LineAvailable">Line Available</option>
                                    <option value="SalesOrderOpened">Activation in progress</option>
                                    <option value="AwaitingOperatorConfirmation">Waiting for operator confirmation</option>
                                    <option value="WaitingForServiceDesk">Waiting for service desk</option>
                                    <option value="Closed">Closed</option>
                                    <option value="Completed">Completed</option>
                                    <option value="ActivationFailed">Activation failed</option>
                                    <option value="IntegrationFailed">Integration Failed</option>
                                </select>
                            </div>
                            @if (filterIsps is not null)
                            {
                                <div class="sm:col-span-2">
                                    <label class="field-label" for="activation-filter-isp">ISP</label>
                                    <select class="field-input" id="activation-filter-isp" name="ispId">
                                        <option value="">All</option>
                                        @foreach (var isp in filterIsps)
                                        {
                                            <option value="@isp.IspId">@isp.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div>
                                <label class="field-label" for="activation-filter-package">Package</label>
                                <select class="field-input" id="activation-filter-package" name="packageCode">
                                    <option value="">All</option>
                                    @foreach (var package in filterPackages)
                                    {
                                        <option value="@package.Code">@package.Name@(package.IsActive ? "" : " (retired)")</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label" for="activation-filter-duration">Contract</label>
                                <select class="field-input" id="activation-filter-duration" name="contractDurationMonths">
                                    <option value="">All</option>
                                    @foreach (var duration in filterDurations.OrderBy(d => d.Months))
                                    {
                                        <option value="@duration.Months">@duration.Label</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label" for="activation-filter-from">Submitted from</label>
                                <input class="field-input" id="activation-filter-from" name="submittedFrom" type="date" />
                            </div>
                            <div>
                                <label class="field-label" for="activation-filter-to">Submitted to</label>
                                <input class="field-input" id="activation-filter-to" name="submittedTo" type="date" />
                            </div>
                        </div>
                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" id="activation-filters-reset" class="btn-secondary">Reset</button>
                            <button type="submit" class="btn-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="activation-filter-chips" class="flex flex-wrap items-center gap-2"></div>
        </div>

        <p id="activation-search-error" class="field-error mt-2" role="alert" hidden></p>
    </section>

    <section class="card min-w-0 p-0" aria-labelledby="activation-grid-heading">
        <h2 id="activation-grid-heading" class="sr-only">Activation requests</h2>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr>
                        <th class="table-head">Request</th>
                        @if (showIsp)
                        {
                            <th class="table-head">ISP</th>
                        }
                        <th class="table-head">Package</th>
                        <th class="table-head">Status</th>
                        <th class="table-head">CRM ticket</th>
                        <th class="table-head">Submitted</th>
                        <th class="table-head w-12"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="activation-search-results"></tbody>
            </table>
        </div>

        @* Two placeholders for an empty grid; the page script shows the one that fits. *@
        <div class="px-6 py-10" id="activation-empty-wrapper" hidden>
            <partial name="_EmptyState" model="@(new EmptyStateModel(EmptyStateIcons.Inbox, "No activation requests yet",
                "Requests submitted for a new line will appear here, with their progress up to activation.",
                ActionLabel: canCreate ? "New request" : null, ActionAttributes: "data-empty-add", Id: "activation-empty-none", Hidden: true))" />
            <partial name="_EmptyState" model="@(new EmptyStateModel(EmptyStateIcons.Search, "No activation requests match",
                "Try a different search, or clear the search and filters.",
                ActionLabel: "Clear search and filters", ActionAttributes: "data-empty-clear", Id: "activation-empty-filtered", Hidden: true))" />
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-6 py-3 text-sm text-ink-muted">
            <span id="activation-search-summary"></span>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2">
                    <span>Per page</span>
                    <select id="activation-page-size" class="field-input mt-0 w-auto py-1.5">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <div class="flex items-center gap-1">
                    <button type="button" id="activation-search-prev" class="icon-button" disabled aria-label="Previous page">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="m12 4-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                    <span id="activation-page-number" class="min-w-[2rem] rounded-md bg-brand-600 px-2.5 py-1 text-center text-xs font-semibold text-white">1</span>
                    <button type="button" id="activation-search-next" class="icon-button" disabled aria-label="Next page">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4"><path d="m8 4 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/activation-admin.js"></script>
}
