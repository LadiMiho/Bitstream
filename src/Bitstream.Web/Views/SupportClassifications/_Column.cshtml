@model SupportClassificationColumnModel
@{
    var headingId = $"classification-level-{Model.Level}";
    var activeCount = Model.Items.Count(i => i.Classification.IsActive);
}
<section class="card flex flex-col p-0" aria-labelledby="@headingId" data-level="@Model.Level">
    <div class="flex items-start justify-between gap-3 border-b border-line px-4 py-3">
        <div class="min-w-0">
            <h2 id="@headingId" class="flex items-center gap-2 text-sm font-semibold text-ink">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-xs text-white">@Model.Level</span>
                @Model.Title
                <span class="badge" title="@activeCount active of @Model.Items.Count">@Model.Items.Count</span>
            </h2>
            <p class="mt-0.5 truncate text-xs text-ink-muted" title="@Model.Hint">@Model.Hint</p>
        </div>
        @if (Model.CanAdd)
        {
            <button type="button" class="btn-secondary shrink-0 px-3 py-1.5" data-classification-action="add"
                    data-parent-id="@Model.Parent?.ClassificationId" aria-label="Add level-@Model.Level item">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                Add
            </button>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="px-4 py-6"><partial name="_EmptyState" model="Model.Empty" /></div>
    }
    else
    {
        <ul class="divide-y divide-line" role="list">
            @foreach (var node in Model.Items)
            {
                var item = node.Classification;
                var selected = item.ClassificationId == Model.SelectedId;
                var rowClass = selected ? "bg-brand-50" : "hover:bg-surface-muted";
                <li class="group flex items-center gap-2 px-2 py-1.5 @rowClass @(item.IsActive ? "" : "opacity-60")"
                    data-classification-id="@item.ClassificationId">
                    @if (Model.SelectHref is not null)
                    {
                        <a href="@Model.SelectHref(item.ClassificationId)" class="flex min-w-0 flex-1 items-center gap-3 rounded-md px-2 py-1.5"
                           aria-current="@(selected ? "true" : null)">
                            <partial name="_ItemText" model="node" />
                            <svg viewBox="0 0 20 20" fill="currentColor" class="ml-auto h-4 w-4 shrink-0 @(selected ? "text-brand-600" : "text-ink-muted")" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </a>
                    }
                    else
                    {
                        <div class="flex min-w-0 flex-1 items-center gap-3 px-2 py-1.5"><partial name="_ItemText" model="node" /></div>
                    }
                    <div class="flex shrink-0 items-center">
                        <button type="button" class="icon-button" data-classification-action="edit"
                                data-id="@item.ClassificationId" data-label="@item.Name" title="Edit" aria-label="Edit @item.Name">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" /></svg>
                        </button>
                        <button type="button" class="icon-button" data-classification-action="@(item.IsActive ? "deactivate" : "activate")"
                                data-id="@item.ClassificationId" data-label="@item.Name" data-level="@item.Level"
                                title="@(item.IsActive ? "Deactivate" : "Activate")" aria-label="@(item.IsActive ? "Deactivate" : "Activate") @item.Name">
                            @if (item.IsActive)
                            {
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM6.75 9.25a.75.75 0 000 1.5h6.5a.75.75 0 000-1.5h-6.5z" clip-rule="evenodd" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                            }
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
</section>
