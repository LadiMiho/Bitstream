@model Bitstream.Application.Abstractions.Persistence.AuditLogRow
@{
    var entry = Model.Entry;

    // Stored values are JSON (sensitive fields already masked when written); show them indented.
    static string Pretty(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(value);
            return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch (System.Text.Json.JsonException)
        {
            return value;
        }
    }
}

<section class="grid gap-4" aria-labelledby="audit-entry-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 id="audit-entry-heading" class="font-mono text-base font-semibold text-ink">@entry.ActionCode</h3>
        @if (entry.ActorUserId is null)
        {
            <span class="status-pill bg-surface-muted text-ink-muted">System</span>
        }
    </div>

    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Time</dt><dd class="mt-1 text-sm"><time datetime="@entry.Timestamp.ToString("O")">@entry.Timestamp.ToString("g")</time></dd></div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">User</dt>
            <dd class="mt-1 text-sm">
                @AccessManagementController.ActorLabel(Model)
                @if (Model.ActorEmail is { Length: > 0 })
                {
                    <span class="block text-xs text-ink-muted">@Model.ActorEmail</span>
                }
            </dd>
        </div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Record</dt><dd class="mt-1 text-sm">@entry.EntityType <span class="font-mono text-xs text-ink-muted">@entry.EntityId</span></dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">IP address / job</dt><dd class="mt-1 font-mono text-sm">@(entry.ActorIp ?? "—")</dd></div>
        <div class="sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Correlation ID</dt><dd class="mt-1 break-all font-mono text-xs">@entry.CorrelationId</dd></div>
    </dl>
</section>

<section class="mt-6 grid gap-4" aria-label="Values">
    <div>
        <h4 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Before</h4>
        <pre class="mt-1 max-h-72 overflow-auto whitespace-pre-wrap break-all rounded bg-surface-muted p-3 text-xs">@Pretty(entry.OldValue)</pre>
    </div>
    <div>
        <h4 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">After</h4>
        <pre class="mt-1 max-h-72 overflow-auto whitespace-pre-wrap break-all rounded bg-surface-muted p-3 text-xs">@Pretty(entry.NewValue)</pre>
    </div>
</section>

<template data-drawer-footer>
    <button type="button" class="btn-secondary" data-drawer-cancel>Close</button>
</template>
