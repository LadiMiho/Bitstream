@model Bitstream.Application.Services.PostActivation.PostActivationFormOptions
@{
    var maxNote = Bitstream.Application.Services.PostActivation.PostActivationRequestService.MaxNoteLength;
}
<form id="post-activation-form" class="grid gap-5" novalidate data-role="post-activation-form">
    <p class="field-error" role="alert" data-field-error="request" hidden></p>

    <div>
        <label class="field-label" for="pa-phonenumber">Phone number</label>
        @if (Model.PhoneNumbers.Count == 0)
        {
            <p class="mt-1 rounded-md border border-line bg-surface-muted px-3 py-2 text-sm text-ink-muted">
                No phone numbers are available for your account yet. They are loaded by BI.
            </p>
            <input type="hidden" name="phonenumber" value="" />
        }
        else
        {
            @if (Model.PhoneNumbers.Count > 10)
            {
                <input class="field-input" type="search" id="pa-phonenumber-filter" placeholder="Type to filter @Model.PhoneNumbers.Count numbers…"
                       aria-label="Filter phone numbers" data-role="phone-filter" autocomplete="off" />
            }
            <select class="field-input font-mono" id="pa-phonenumber" name="phonenumber" required>
                <option value="">Select a phone number</option>
                @foreach (var phone in Model.PhoneNumbers)
                {
                    <option value="@phone">@phone</option>
                }
            </select>
        }
        <p class="field-error" role="alert" data-field-error="phonenumber" hidden></p>
    </div>

    <fieldset class="grid gap-3">
        <legend class="field-label">Classification</legend>
        @if (Model.Classifications.Count == 0)
        {
            <p class="rounded-md border border-line bg-surface-muted px-3 py-2 text-sm text-ink-muted">
                No classifications are active. An administrator can add them under Support classifications.
            </p>
        }
        <div>
            <label class="text-xs font-semibold uppercase tracking-wide text-ink-muted" for="pa-class-1">1 · Request type</label>
            <select class="field-input" id="pa-class-1" data-level="1" required></select>
        </div>
        <div>
            <label class="text-xs font-semibold uppercase tracking-wide text-ink-muted" for="pa-class-2">2 · Category</label>
            <select class="field-input" id="pa-class-2" data-level="2" required disabled></select>
        </div>
        <div>
            <label class="text-xs font-semibold uppercase tracking-wide text-ink-muted" for="pa-class-3">3 · Detail</label>
            <select class="field-input" id="pa-class-3" data-level="3" name="classificationId" required disabled></select>
        </div>
        <p class="field-error" role="alert" data-field-error="classificationId" hidden></p>
        <script type="application/json" data-role="classification-tree">@Html.Raw(Bitstream.Web.Controllers.PostActivationController.ClassificationsJson(Model.Classifications))</script>
    </fieldset>

    <div>
        <label class="field-label" for="pa-note">Note <span class="font-normal text-ink-muted">(optional)</span></label>
        <textarea class="field-input" id="pa-note" name="note" rows="5" maxlength="@maxNote" data-role="note"></textarea>
        <span class="mt-1 block text-right text-xs text-ink-muted"><span data-role="note-count">0</span> / @maxNote</span>
        <p class="field-error" role="alert" data-field-error="note" hidden></p>
    </div>
</form>
<template data-drawer-footer>
    <button type="button" class="btn-secondary" data-drawer-cancel>Cancel</button>
    <button type="submit" form="post-activation-form" class="btn-primary">Submit</button>
</template>
