@using Bitstream.Application.Services.Activation
@using Bitstream.Hosting.Security
<section class="card" aria-labelledby="page-heading">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <h1 id="page-heading" class="text-xl font-semibold">Post-Activation Support</h1>
        @if (User.HasClaim(BitstreamClaimTypes.Permission, ActivationPermissionCodes.CatalogueManage))
        {
            <a href="/PostActivation/Classifications" class="btn-secondary">Classifications</a>
        }
    </div>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">
        Complaint tickets, the closure handshake, auto-confirmation and service status
        changes (TRD §6) will be built here — this page is a placeholder reachable from the
        navigation until then.
    </p>
</section>
