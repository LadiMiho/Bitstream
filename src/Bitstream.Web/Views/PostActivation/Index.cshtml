@model IReadOnlyList<Bitstream.Domain.Entities.PostActivationRequest>
@{
    ViewData["Title"] = "Post-Activation Support";
    var canCreate = (bool)(ViewBag.CanCreate ?? false);
    var canManageClassifications = (bool)(ViewBag.CanManageClassifications ?? false);
    var showIsp = (bool)(ViewBag.ShowIsp ?? false);
}

<div class="grid gap-6" data-role="post-activation-page">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold">Post-Activation Support</h1>
            <p class="mt-1 text-sm text-ink-muted">Requests for an active line, sent to CRM by phone number and classification.</p>
        </div>

        <div class="flex items-center gap-2">
            @if (canManageClassifications)
            {
                <a href="/PostActivation/Classifications" class="btn-secondary">Classifications</a>
            }
            @if (canCreate)
            {
                <button type="button" class="btn-primary" data-post-activation-action="new">New request</button>
            }
        </div>
    </div>

    <section class="card min-w-0 p-0" aria-labelledby="post-activation-heading">
        <h2 id="post-activation-heading" class="sr-only">Post-activation requests</h2>

        @if (Model.Count == 0)
        {
            <div class="px-6 py-10">
                <partial name="_EmptyState" model="@(canCreate
                    ? new EmptyStateModel(EmptyStateIcons.Inbox, "No post-activation requests yet",
                        "Pick a phone number and a classification to send a request to CRM.",
                        ActionLabel: "New request", ActionAttributes: "data-post-activation-action=\"new\"")
                    : new EmptyStateModel(EmptyStateIcons.Inbox, "No post-activation requests yet",
                        "Requests submitted for active lines will appear here."))" />
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr>
                            <th class="table-head">Request</th>
                            @if (showIsp)
                            {
                                <th class="table-head">ISP</th>
                            }
                            <th class="table-head">Phone number</th>
                            <th class="table-head">Classification</th>
                            <th class="table-head">Status</th>
                            <th class="table-head">CRM ticket</th>
                            <th class="table-head">Submitted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr class="cursor-pointer border-t border-line hover:bg-surface-muted" tabindex="0"
                                data-post-activation-action="view" data-public-id="@request.PublicId">
                                <td class="table-cell font-medium text-brand-700">@request.PublicId</td>
                                @if (showIsp)
                                {
                                    <td class="table-cell">@request.Isp?.Name</td>
                                }
                                <td class="table-cell font-mono text-xs">@request.Phonenumber</td>
                                <td class="table-cell">
                                    <div class="text-ink">@request.Classification3Name</div>
                                    <div class="text-xs text-ink-muted">@request.Classification1Name › @request.Classification2Name · <span class="font-mono">@request.Classification3Code</span></div>
                                </td>
                                <td class="table-cell whitespace-nowrap"><span class="@PostActivationRequestLabels.PillClass(request.Status)">@PostActivationRequestLabels.For(request.Status)</span></td>
                                <td class="table-cell font-mono text-xs">@(request.CrmTicketId ?? "—")</td>
                                <td class="table-cell whitespace-nowrap text-ink-muted">@request.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/post-activation.js"></script>
}
