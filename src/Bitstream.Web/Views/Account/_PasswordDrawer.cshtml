@model Bitstream.Web.Controllers.AccountViewModel
<form id="account-password-form" class="grid gap-4" novalidate data-role="account-password-form">
    <p class="text-sm text-ink-muted">Changing the password of <strong>@Model.FullName</strong> (@Model.Email). You stay signed in here; any other session of yours is signed out.</p>
    <p class="field-error" role="alert" data-field-error="request" hidden></p>

    <div>
        <label class="field-label" for="account-current-password">Current password</label>
        <div class="field-input-group">
            <input class="field-input" id="account-current-password" name="currentPassword" type="password" autocomplete="current-password" required />
            <button type="button" class="field-toggle" data-password-toggle="account-current-password" aria-label="Show password">Show</button>
        </div>
        <p class="field-error" role="alert" data-field-error="currentPassword" hidden></p>
    </div>

    <div>
        <label class="field-label" for="account-new-password">New password</label>
        <div class="field-input-group">
            <input class="field-input" id="account-new-password" name="newPassword" type="password" autocomplete="new-password" aria-describedby="account-password-rules" required />
            <button type="button" class="field-toggle" data-password-toggle="account-new-password" aria-label="Show password">Show</button>
        </div>
        <p id="account-password-rules" class="mt-1 text-xs text-ink-muted">At least @Model.PasswordMinLength characters, using at least @Model.PasswordMinCharacterClasses of: lowercase, uppercase, digits, symbols. It can't be one of your recent passwords.</p>
        <p class="field-error" role="alert" data-field-error="newPassword" hidden></p>
    </div>

    <div>
        <label class="field-label" for="account-confirm-password">Confirm new password</label>
        <div class="field-input-group">
            <input class="field-input" id="account-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required />
            <button type="button" class="field-toggle" data-password-toggle="account-confirm-password" aria-label="Show password">Show</button>
        </div>
        <p class="field-error" role="alert" data-field-error="confirmPassword" hidden></p>
    </div>
</form>
<template data-drawer-footer>
    <button type="button" class="btn-secondary" data-drawer-cancel>Cancel</button>
    <button type="submit" form="account-password-form" class="btn-primary">Change password</button>
</template>
