@model Bitstream.Web.Controllers.AccountViewModel
@{
    ViewData["Title"] = "My account";

    static string When(DateTimeOffset? value) => value is { } instant ? instant.ToLocalTime().ToString("d MMM yyyy, HH:mm") : "—";

    var nameParts = Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0 ? "?" : (nameParts[0][..1] + (nameParts.Length > 1 ? nameParts[^1][..1] : string.Empty)).ToUpperInvariant();
}

<div class="grid gap-6" data-role="account-page">
    <div>
        <h1 class="text-xl font-semibold">My account</h1>
        <p class="mt-1 text-sm text-ink-muted">Your details in the Bitstream Portal, and your password.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <section class="card min-w-0 p-0" aria-labelledby="account-details-heading">
            <div class="flex items-center gap-4 border-b border-line px-6 py-5">
                <span class="avatar-circle h-12 w-12 text-base" aria-hidden="true">@initials</span>
                <div class="min-w-0">
                    <h2 id="account-details-heading" class="truncate text-lg font-semibold text-ink">@Model.FullName</h2>
                    <div class="mt-1 flex flex-wrap items-center gap-2">
                        <span class="status-pill bg-brand-50 text-brand-700">@Model.RoleName</span>
                        @if (Model.IspName is not null)
                        {
                            <span class="text-sm text-ink-muted">@Model.IspName</span>
                        }
                    </div>
                </div>
            </div>

            <dl class="grid gap-x-6 gap-y-4 px-6 py-5 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Email</dt><dd class="mt-1 break-all text-sm">@Model.Email</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Mobile</dt><dd class="mt-1 text-sm">@Model.Mobile</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Role</dt><dd class="mt-1 text-sm">@Model.RoleName</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">ISP</dt><dd class="mt-1 text-sm">@(Model.IspName ?? "— (internal user)")</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Two-step verification</dt><dd class="mt-1 text-sm">@(Model.TwoFactorEnabled ? "On: a verification code is asked at every sign-in" : "Off")</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Last sign-in</dt><dd class="mt-1 text-sm">@When(Model.LastLoginAt)</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Password last changed</dt><dd class="mt-1 text-sm" id="account-password-updated">@When(Model.PasswordUpdatedAt)</dd></div>
                <div><dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Account created</dt><dd class="mt-1 text-sm">@When(Model.CreatedAt)</dd></div>
            </dl>
            <p class="border-t border-line px-6 py-3 text-xs text-ink-muted">To change your name, email or mobile, ask an administrator.</p>
        </section>

        <section class="card min-w-0 p-0" id="password" aria-labelledby="account-password-heading">
            <div class="border-b border-line px-6 py-5">
                <h2 id="account-password-heading" class="text-lg font-semibold text-ink">Change password</h2>
                <p class="mt-1 text-sm text-ink-muted">You stay signed in here; any other session of yours is signed out.</p>
            </div>

            <form id="account-password-form" class="grid gap-4 px-6 py-5" novalidate>
                <p class="rounded-md border border-state-done/30 bg-state-done/10 px-3 py-2 text-sm text-state-done" id="account-password-success" role="status" hidden>Your password has been changed.</p>
                <p class="field-error" role="alert" data-field-error="request" hidden></p>

                <div>
                    <label class="field-label" for="account-current-password">Current password</label>
                    <div class="field-input-group">
                        <input class="field-input" id="account-current-password" name="currentPassword" type="password" autocomplete="current-password" required />
                        <button type="button" class="field-toggle" data-password-toggle="account-current-password" aria-label="Show password">Show</button>
                    </div>
                    <p class="field-error" role="alert" data-field-error="currentPassword" hidden></p>
                </div>

                <div>
                    <label class="field-label" for="account-new-password">New password</label>
                    <div class="field-input-group">
                        <input class="field-input" id="account-new-password" name="newPassword" type="password" autocomplete="new-password" aria-describedby="account-password-rules" required />
                        <button type="button" class="field-toggle" data-password-toggle="account-new-password" aria-label="Show password">Show</button>
                    </div>
                    <p id="account-password-rules" class="mt-1 text-xs text-ink-muted">At least @Model.PasswordMinLength characters, using at least @Model.PasswordMinCharacterClasses of: lowercase, uppercase, digits, symbols. It can't be one of your recent passwords.</p>
                    <p class="field-error" role="alert" data-field-error="newPassword" hidden></p>
                </div>

                <div>
                    <label class="field-label" for="account-confirm-password">Confirm new password</label>
                    <div class="field-input-group">
                        <input class="field-input" id="account-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required />
                        <button type="button" class="field-toggle" data-password-toggle="account-confirm-password" aria-label="Show password">Show</button>
                    </div>
                    <p class="field-error" role="alert" data-field-error="confirmPassword" hidden></p>
                </div>

                <div>
                    <button type="submit" class="btn-primary">Change password</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/account.js"></script>
}
