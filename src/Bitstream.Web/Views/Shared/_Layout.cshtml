@using System.Security.Claims
@inject IWebHostEnvironment Env
@{
    // Request.Path rather than a page/action route value: it identifies the current screen the
    // same way for every controller, so this one check works everywhere.
    var currentPage = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;

    bool IsActive(string prefix) => currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.Identity?.Name;
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value;

    // The login page shows only the logo above its box (Views/Auth/Login.cshtml), no header.
    var hideHeader = ViewData["HideHeader"] is true;

    // Initials for the account menu's avatar, e.g. "Vladimir Miho" -> "VM".
    var nameParts = (displayName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0 ? "?" : (nameParts[0][..1] + (nameParts.Length > 1 ? nameParts[^1][..1] : string.Empty)).ToUpperInvariant();
}
@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Chevron() => new Microsoft.AspNetCore.Html.HtmlString(
        "<svg viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"h-4 w-4 opacity-60\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z\" clip-rule=\"evenodd\"/></svg>");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <!-- TR-NFR-11: responsive and usable on desktop and tablet resolutions. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bitstream Portal</title>
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="min-h-screen bg-surface-muted font-sans text-ink antialiased">

    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-surface focus:px-3 focus:py-2">
        Skip to content
    </a>

    @if (!hideHeader)
    {
    <header class="border-b-2 border-accent-500 bg-surface">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
            @* Narrower screens keep the logo and the navigation; the title, the environment and
               the user's name appear as the width allows (lg / xl / 2xl). *@
            <div class="flex shrink-0 items-center gap-3">
                <a href="/" class="flex items-center gap-3" aria-label="Bitstream Portal home">
                    <img src="~/img/one-logo-header.png" alt="one" width="59" height="32" class="h-8 w-auto" />
                    <span class="hidden h-6 w-px bg-line lg:block" aria-hidden="true"></span>
                    <span class="hidden whitespace-nowrap text-lg font-semibold text-brand-700 lg:inline">Bitstream Portal</span>
                </a>
                <span class="status-pill hidden bg-brand-50 text-brand-700 xl:inline-flex">@Env.EnvironmentName</span>
            </div>

            <!-- TR-SEC-17: this navigation only decides what is offered to click. Every module's
                 own calls are authorised server-side regardless of whether a link to it is shown
                 here — reaching a page without a session is separately stopped by
                 RequireSessionAttribute (TR-SEC-20), not by this list being short. -->
            @if (isAuthenticated)
            {
                <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
                    <a class="nav-link @(IsActive("/Dashboard") ? "nav-link-active" : "")" aria-current="@(IsActive("/Dashboard") ? "page" : null)" href="/Dashboard">Dashboard</a>

                    @* Dropdown groups: wwwroot/js/nav.js opens and closes them. *@
                    <div class="nav-menu" data-nav-menu>
                        <button type="button" class="nav-link nav-trigger @(IsActive("/ActivationRequests") || IsActive("/PostActivation") ? "nav-link-active" : "")" aria-haspopup="true" aria-expanded="false" data-nav-trigger>
                            Activations @Chevron()
                        </button>
                        <div class="nav-dropdown" hidden data-nav-panel>
                            <a class="nav-dropdown-item @(IsActive("/ActivationRequests") ? "nav-dropdown-item-active" : "")" aria-current="@(IsActive("/ActivationRequests") ? "page" : null)" href="/ActivationRequests">Activation Requests</a>
                            <a class="nav-dropdown-item @(IsActive("/PostActivation") ? "nav-dropdown-item-active" : "")" aria-current="@(IsActive("/PostActivation") ? "page" : null)" href="/PostActivation">Post-Activation Support</a>
                        </div>
                    </div>

                    <div class="nav-menu" data-nav-menu>
                        <button type="button" class="nav-link nav-trigger @(IsActive("/AccessManagement") ? "nav-link-active" : "")" aria-haspopup="true" aria-expanded="false" data-nav-trigger>
                            Access Management @Chevron()
                        </button>
                        <div class="nav-dropdown" hidden data-nav-panel>
                            <a class="nav-dropdown-item @(IsActive("/AccessManagement/Isps") ? "nav-dropdown-item-active" : "")" aria-current="@(IsActive("/AccessManagement/Isps") ? "page" : null)" href="/AccessManagement/Isps">ISP Administration</a>
                            <a class="nav-dropdown-item @(IsActive("/AccessManagement/Users") ? "nav-dropdown-item-active" : "")" aria-current="@(IsActive("/AccessManagement/Users") ? "page" : null)" href="/AccessManagement/Users">User Administration</a>
                            <a class="nav-dropdown-item @(IsActive("/AccessManagement/AuditLog") ? "nav-dropdown-item-active" : "")" aria-current="@(IsActive("/AccessManagement/AuditLog") ? "page" : null)" href="/AccessManagement/AuditLog">Audit Logs</a>
                        </div>
                    </div>

                    <a class="nav-link @(IsActive("/Reporting") ? "nav-link-active" : "")" aria-current="@(IsActive("/Reporting") ? "page" : null)" href="/Reporting">Reporting</a>
                </nav>
            }

            <div class="flex shrink-0 items-center gap-3">
                @if (isAuthenticated)
                {
                    @* User menu: name, role and sign out, as the usual account dropdown. *@
                    <div class="nav-menu" data-nav-menu>
                        <button type="button" class="user-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Account menu for @displayName" data-nav-trigger>
                            <span class="avatar-circle" aria-hidden="true">@initials</span>
                            <span class="hidden max-w-40 truncate text-sm font-medium text-ink lg:inline">@displayName</span>
                            @Chevron()
                        </button>
                        <div class="nav-dropdown nav-dropdown-right" hidden data-nav-panel>
                            <div class="border-b border-line px-4 py-3">
                                <div class="truncate text-sm font-semibold text-ink">@displayName</div>
                                @if (!string.IsNullOrEmpty(roleName))
                                {
                                    <div class="mt-1"><span class="status-pill bg-brand-50 text-brand-700">@roleName</span></div>
                                }
                            </div>
                            <form method="post" asp-controller="Auth" asp-action="LogoutPage">
                                <button type="submit" class="nav-dropdown-item w-full text-left">Sign out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>
    }

    <main id="main" class="@(hideHeader ? "" : "mx-auto max-w-7xl px-4 py-8")">
        @RenderBody()
    </main>

    <!--
        Drawer: the one slide-out panel shared by every add/edit/view/change-password action on
        every admin screen (wwwroot/js/drawer.js), filled with a different server-rendered
        partial fetched on demand by whichever page opens it. Living here, once, means a page
        never has to declare this markup itself to use a drawer.
    -->
    <div id="drawer-backdrop" class="drawer-backdrop" hidden></div>
    <aside id="drawer" class="drawer" hidden aria-hidden="true" aria-labelledby="drawer-title">
        <div class="drawer-header">
            <h2 id="drawer-title" class="text-lg font-semibold"></h2>
            <button type="button" id="drawer-close" class="drawer-close" aria-label="Close">&times;</button>
        </div>
        <div id="drawer-body" class="drawer-body"></div>
        <div id="drawer-footer" class="drawer-footer"></div>
    </aside>

    <!-- Standard confirmation popup for a single-click action (delete / lock / unlock, ...) — a
         page uses it instead of a drawer when there is no form, just a yes/no decision. -->
    <div id="confirm-backdrop" class="drawer-backdrop" hidden></div>
    <div id="confirm-modal" class="confirm-modal" hidden role="alertdialog" aria-modal="true" aria-labelledby="confirm-message">
        <p id="confirm-message" class="text-sm text-ink"></p>
        <div class="mt-4 flex justify-end gap-2">
            <button type="button" id="confirm-cancel" class="btn-secondary">Cancel</button>
            <button type="button" id="confirm-ok" class="btn-primary">Confirm</button>
        </div>
    </div>

    <script type="module" src="~/js/nav.js"></script>
    <script type="module" src="~/js/drawer.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
