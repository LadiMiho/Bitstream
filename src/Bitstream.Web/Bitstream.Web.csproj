<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Bitstream.Web</RootNamespace>
    <UserSecretsId>bitstream-portal-web</UserSecretsId>
    <!-- Windows Server / IIS hosting. No container targets are imported anywhere. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitstream.Application\Bitstream.Application.csproj" />
    <ProjectReference Include="..\Bitstream.Domain\Bitstream.Domain.csproj" />
    <ProjectReference Include="..\Bitstream.Hosting\Bitstream.Hosting.csproj" />
    <!-- Composition root: the portal site resolves the application's ports to concrete
         adapters here and nowhere else. Persistence is what the screens ultimately read and
         write through; Integration is referenced because submitting a request enqueues CRM
         work on the outbox, even though this host never dispatches it (the API host does). -->
    <ProjectReference Include="..\Bitstream.Infrastructure.Persistence\Bitstream.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Bitstream.Infrastructure.Integration\Bitstream.Infrastructure.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Renders the TOTP enrollment QR code (Controllers/AuthController.cs). Presentation-only:
         the decision that a login needs one at all is AuthController.Login's own (whether
         UserManager.GetAuthenticatorKeyAsync returns null), not this package's. -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <!-- `dotnet ef` design-time tooling resolves against the *startup* project, not the one
         holding the DbContext — Bitstream.Infrastructure.Persistence.csproj already references
         this, but `dotnet ef database update` run with Bitstream.Web as the startup project
         still needs it here too. Not referenced by any shipped runtime path. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Tailwind. The stylesheet source is ClientAssets/app.css; the compiled output is
    wwwroot/css/app.css, referenced by Pages/Shared/_Layout.cshtml. No Node.js, npm or
    package.json: the standalone Tailwind CLI is a self-contained native executable,
    downloaded on demand into tools/tailwindcss/ (outside source control) and invoked as a
    plain MSBuild Exec step.

    Build or publish with -p:BuildFrontend=true to (re)compile it; that is the only step
    needing network access, and only the first time, to fetch the CLI binary.
  -->
  <PropertyGroup>
    <TailwindCliVersion>4.3.3</TailwindCliVersion>
    <TailwindToolsDir>$(MSBuildThisFileDirectory)..\..\tools\tailwindcss\</TailwindToolsDir>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">false</BuildFrontend>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildFrontend)' == 'true'">
    <TailwindCliAsset Condition="'$(OS)' == 'Windows_NT'">tailwindcss-windows-x64.exe</TailwindCliAsset>
    <TailwindCliAsset Condition="'$(OS)' != 'Windows_NT' AND $([MSBuild]::IsOSPlatform('OSX'))">tailwindcss-macos-arm64</TailwindCliAsset>
    <TailwindCliAsset Condition="'$(OS)' != 'Windows_NT' AND $([MSBuild]::IsOSPlatform('Linux'))">tailwindcss-linux-x64</TailwindCliAsset>
    <TailwindCliPath>$(TailwindToolsDir)$(TailwindCliAsset)</TailwindCliPath>
  </PropertyGroup>

  <Target Name="EnsureTailwindCli" Condition="'$(BuildFrontend)' == 'true' AND !Exists('$(TailwindCliPath)')">
    <Error Condition="'$(TailwindCliAsset)' == ''" Text="No standalone Tailwind CLI release is mapped for this OS. Supported: Windows, Linux, macOS." />
    <MakeDir Directories="$(TailwindToolsDir)" />
    <DownloadFile
      SourceUrl="https://github.com/tailwindlabs/tailwindcss/releases/download/v$(TailwindCliVersion)/$(TailwindCliAsset)"
      DestinationFolder="$(TailwindToolsDir)" />
    <!-- GitHub release assets ship without the executable bit; Windows ignores file-mode bits. -->
    <Exec Command="chmod +x &quot;$(TailwindCliPath)&quot;" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <Target Name="BuildFrontendAssets"
          DependsOnTargets="EnsureTailwindCli"
          BeforeTargets="Build;ComputeFilesToPublish"
          Condition="'$(BuildFrontend)' == 'true'">
    <Exec Command="&quot;$(TailwindCliPath)&quot; -i ClientAssets/app.css -o wwwroot/css/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="WarnIfStylesheetMissing" BeforeTargets="ComputeFilesToPublish">
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\app.css')"
             Text="wwwroot/css/app.css not found. Build or publish with -p:BuildFrontend=true to compile it." />
  </Target>

</Project>
