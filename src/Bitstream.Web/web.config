<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the Bitstream Portal API on Windows Server.
  The ASP.NET Core Module v2 hosts the application in process (see AspNetCoreHostingModel
  in the project file). Publishing overwrites the processPath and arguments attributes.

  This file is the deployment contract for the web tier: there is no container image, no
  compose file and no orchestrator anywhere in this solution.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        IIS's WebDAV module claims PUT, PATCH and DELETE requests and answers them with
        "405 Method Not Allowed" before they reach the application. Every edit and status change
        in the portal uses PUT or PATCH, so it is removed for this site.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Bitstream.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Set per environment by the deployment script; never checked in (TR-ARC-07). -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            Database connection (required). Not checked in: set it on the server here, or in
            appsettings.Production.json next to the dll. With Trusted_Connection=True the IIS
            application pool identity needs a login on SQL Server; otherwise use SQL authentication.
          <environmentVariable name="ConnectionStrings__BitstreamDb" value="Server=SQLHOST;Database=BitstreamPortal;Trusted_Connection=True;TrustServerCertificate=True" />
          -->
          <!--
            Test servers without an HTTPS binding only: lets the sign-in cookie work over plain
            http:// (cookies are then not marked Secure). Never in production (TR-SEC-26).
          <environmentVariable name="Security__AllowInsecureHttp" value="true" />
          -->
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!-- Attachment size is configurable; whether attachments are in Release 1 at all
               is TRD 11.4 open item 12. 30 MB placeholder. -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- TR-SEC-27: OWASP Top 10 hardening at the edge. -->
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="no-referrer" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
