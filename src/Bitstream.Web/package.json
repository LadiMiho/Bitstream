{
  "name": "bitstream-portal-web",
  "version": "0.1.0",
  "private": true,
  "description": "Bitstream Portal frontend — vanilla JavaScript and Tailwind CSS, no framework and no bundler.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./wwwroot/css/app.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
