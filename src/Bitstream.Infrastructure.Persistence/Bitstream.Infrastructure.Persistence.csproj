<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bitstream.Infrastructure.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitstream.Application\Bitstream.Application.csproj" />
    <ProjectReference Include="..\Bitstream.Domain\Bitstream.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- IHostedService, for the start-up schema version guard. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!--
    BitstreamDbContext's physical schema is owned by the numbered T-SQL scripts in /db/mssql
    (see docs/adr/0002-physical-data-model.md) — EF Core is mapped to it and does not generate it,
    no migrations. BitstreamIdentityDbContext (Identity/) is the one deliberate exception: its
    schema (the standard AspNetUsers/AspNetRoles/... tables) is EF-migration-owned, under
    Identity/Migrations/.
  -->

</Project>
