<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />

    <!-- UserManager<User>/RoleManager<Role> for credential storage (TR-SEC-01/02) and the
         user/role CRUD surface, backed by Identity's own EF store and migrations
         (Bitstream.Infrastructure.Persistence/Identity/BitstreamIdentityDbContext.cs). ADR-0002
         ("no EF migrations, ever") is narrowly overridden for this one subsystem only — every
         other table stays on the hand-written T-SQL under db/mssql/, unmigrated. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />

    <!-- UserManager<User>/RoleManager<Role> themselves (Bitstream.Application's own reference) —
         the managers/interfaces, no EF Core, no database driver. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />

    <!-- IdentityUser<TKey>/IdentityRole<TKey> (Bitstream.Application/Identity/User.cs, Role.cs).
         Deliberately the "Stores" package, not "...EntityFrameworkCore" — Application must not
         reference an EF-Core-flavored Identity package; the EF store itself lives only in
         Bitstream.Infrastructure.Persistence. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.0" />

    <!-- Needed only for the `dotnet ef migrations` design-time tooling
         (BitstreamIdentityDbContextFactory). Not referenced by any shipped assembly's runtime
         path. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />

    <!-- ASP.NET Core's own encryption-at-rest primitive (not a bespoke cipher), used to protect
         the TOTP authenticator key and other rows in the UserTokens table
         (BitstreamIdentityDbContext) — the same building block Identity itself uses for its own
         cookies and Default token provider. 10.0.7, not 10.0.0: fixes GHSA-9mv3-2cwr-p262 (CVE-2026-40372,
         critical — a validation bypass letting an attacker forge authentication cookies and decrypt
         protected payloads), exactly the surface this package is used for here. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />

    <!-- Transitive dependency pulled in by Microsoft.AspNetCore.Identity.EntityFrameworkCore.
         Pinned explicitly (CentralPackageTransitivePinningEnabled) because the version it would
         otherwise resolve to, 9.0.0, has several known high-severity advisories (NU1903, Warning
         As Error) — GHSA-23rf-6693-g89p and others. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.0" />

    <!-- Presentation -->
    <!-- 10.0.11, not 10.0.0: pulls Microsoft.OpenApi >= 2.7.5, patching GHSA-v5pm-xwqc-g5wc
         (a circular-schema-reference stack overflow in Microsoft.OpenApi 2.0.0-preview.11
         through 2.7.4). NU1903 (Warning As Error) fails restore on the vulnerable range. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!-- Renders the TOTP enrollment QR code server-side (Bitstream.Web only). Pure managed,
         PNG-byte output with no System.Drawing dependency — matters on a Windows Server target
         with no build step, same reasoning as the Argon2 package above. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />

    <!-- Security -->
    <!-- Argon2id (TR-SEC-02). Pure managed implementation, no native dependency — matters on a
         Windows Server / IIS target with no build step at the destination. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- Cross-cutting -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />

    <!-- Tests -->
    <!-- InMemory stands in for SQL Server only in tests that need a real query pipeline behind
         a repository (no SQL Server instance is available in this environment, see
         README.md "Verification status"). Bulk operations (ExecuteUpdateAsync) are not
         supported by this provider, so tests that exercise them use hand-written fakes instead. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

</Project>
