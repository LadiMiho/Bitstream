{
  "info": {
    "name": "Bitstream – CRM inbound API",
    "_postman_id": "6f1c0d4e-6a57-4d0e-9a2f-3b8e4c1d2a90",
    "description": "Calls CRM makes to the Bitstream integration host (Bitstream.Api). See docs/integration/crm-inbound-api.md.\n\nEvery call needs the `X-Api-Key` header (collection auth, from `{{apiKey}}`). `eventId` and `occurredAt` are generated fresh before each request, so each send is a new, newer event. Set `identifier` to the request you are testing (e.g. TRING_001).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A new eventId per send (a repeated one is treated as a duplicate and ignored),",
          "// and occurredAt = now, so each later step is newer than the last one applied.",
          "pm.variables.set('eventId', 'crm-evt-' + Date.now());",
          "pm.variables.set('occurredAt', new Date().toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7292"
    },
    {
      "key": "apiKey",
      "value": "dev-crm-inbound-key"
    },
    {
      "key": "identifier",
      "value": "TRING_001"
    },
    {
      "key": "crmTicketNumber",
      "value": "8009521719"
    },
    {
      "key": "salesOrderId",
      "value": "SO-4500123"
    },
    {
      "key": "complaintIdentifier",
      "value": "TRING_002"
    }
  ],
  "item": [
    {
      "name": "Activation request steps",
      "description": "In flow order. The portal itself does submission, Business Partner and ticket creation; the request then waits in AwaitingGisVerification.",
      "item": [
        {
          "name": "1a. LINE_AVAILABLE (line check: line exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"LINE_AVAILABLE\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**AwaitingGisVerification → LineAvailable.** CRM's GIS line check found a line."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. NO_LINE (line check: no line)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"NO_LINE\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {\n    \"reason\": \"No fibre in this street\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**AwaitingGisVerification → RejectedNoLine.** `payload.reason` is required (422 without it) and is shown on the request as its status reason. Use either 1a or 1b, not both."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. SALES_ORDER_OPENED (\"Activation in progress\")",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"SALES_ORDER_OPENED\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {\n    \"salesOrderId\": \"{{salesOrderId}}\",\n    \"businessPartner\": \"1102017112\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**LineAvailable → SalesOrderOpened**, shown in the portal as *Activation in progress*. `payload.salesOrderId` is required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. LINE_ACTIVATED (operator must confirm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"LINE_ACTIVATED\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**SalesOrderOpened → AwaitingOperatorConfirmation.** The line is active on CRM's side; the ISP's operator now confirms in the portal whether it works (Yes → Completed; No → Waiting for service desk). Those portal steps are not API calls."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Addressed by CRM ticket number (LINE_AVAILABLE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
