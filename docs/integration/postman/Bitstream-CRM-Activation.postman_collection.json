        {
          "name": "Duplicate eventId – send twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"crm-evt-duplicate-demo\",\n  \"eventType\": \"LINE_AVAILABLE\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses a fixed eventId. The first send is applied (or refused by status); every later send returns 200 with `\"duplicate\": true` and changes nothing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Second send is a duplicate', () => { if (pm.response.code === 200) { pm.expect(pm.response.json()).to.have.property('duplicate'); } });"
                ]
              }
            }
          ]
        }
      ]
