{
  "info": {
    "name": "Bitstream – CRM inbound API (activation)",
    "_postman_id": "3c7e9b52-41d8-4f6a-9e0d-5b2a7c1e8f43",
    "description": "Calls CRM makes to the Bitstream portal's integration API to report the progress of an activation request. See the accompanying document \"Bitstream CRM Inbound API\".\n\nBefore sending: set `apiKey` (supplied separately) in the environment, and set `identifier` to a real request ID (e.g. TRING001) or use the CRM ticket number variant. `eventId` and `occurredAt` are generated fresh before each send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A new eventId per send (a repeated one is treated as a duplicate and ignored),",
          "// and occurredAt = now, so each later step is newer than the last one applied.",
          "pm.variables.set('eventId', 'crm-evt-' + Date.now());",
          "pm.variables.set('occurredAt', new Date().toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://10.89.4.19:9972"
    },
    {
      "key": "apiKey",
      "value": "<provided separately>"
    },
    {
      "key": "identifier",
      "value": "TRING001"
    },
    {
      "key": "crmTicketNumber",
      "value": "8009521719"
    },
    {
      "key": "salesOrderTicket",
      "value": "8009530001"
    }
  ],
  "item": [
    {
      "name": "Activation request steps",
      "description": "In flow order. The portal itself does submission, Business Partner and ticket creation; the request then waits in AwaitingGisVerification.",
      "item": [
        {
          "name": "1a. LINE_AVAILABLE (line check: line exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"LINE_AVAILABLE\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**AwaitingGisVerification → LineAvailable.** CRM's GIS line check found a line."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. NO_LINE (line check: no line)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{identifier}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{identifier}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"NO_LINE\",\n  \"identifier\": \"{{identifier}}\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {\n    \"reason\": \"No fibre in this street\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**AwaitingGisVerification → RejectedNoLine.** `payload.reason` is required (422 without it) and is shown on the request as its status reason. Use either 1a or 1b, not both."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. SALES_ORDER_OPENED (\"Activation in progress\")",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{salesOrderTicket}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{salesOrderTicket}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"SALES_ORDER_OPENED\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {\n    \"salesOrderId\": \"{{identifier}}\",\n    \"businessPartner\": \"1102017112\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**LineAvailable → SalesOrderOpened**, shown in the portal as *Activation in progress*. Sent to the **new ticket CRM opened for the sales order** (`{{salesOrderTicket}}`), which the portal does not know yet: `payload.salesOrderId` must be the **portal's request ID** (`{{identifier}}`, e.g. TRING001) — that is how the request is found. The new ticket is stored on the request, so later events may be addressed to it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. LINE_ACTIVATED (operator must confirm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{salesOrderTicket}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{salesOrderTicket}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"LINE_ACTIVATED\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {\n    \"salesOrderId\": \"{{identifier}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**SalesOrderOpened → AwaitingOperatorConfirmation**. Sent to the sales order ticket (`{{salesOrderTicket}}`); `payload.salesOrderId` must be the **portal's request ID** (`{{identifier}}`, e.g. TRING001) — that is how the request is found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Addressed by CRM ticket number (LINE_AVAILABLE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{crmTicketNumber}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{crmTicketNumber}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"LINE_AVAILABLE\",\n  \"crmTicketId\": \"{{crmTicketNumber}}\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same as 1a, but the URL carries CRM's own ticket number (EV_TICKET_NO) instead of the portal ID. The body's `identifier` is omitted: when present it must equal the URL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
