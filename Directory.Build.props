<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Scaffold stage: stub members are intentionally undocumented in places. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Bitstream Portal</Product>
    <Company>My Company — Wholesale</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    TR-ARC-01 / TR-ARC-02: the layering rule is enforced by project references only.
    Domain      -> (nothing)
    Application -> Domain
    Persistence -> Application, Domain
    Integration -> Application, Domain
    Api         -> Application, Domain, Persistence, Integration  (composition root only)
    No Infrastructure.* project may be referenced from Domain or Application.
    tests/Bitstream.ArchitectureTests asserts this at build time.
  -->

</Project>
